#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

target="${1:-website}"
mode="${2:-}"

user="1000:1000"
if [[ "$mode" == "root" ]]; then
  user="root:root"
elif [[ -n "$mode" ]]; then
  echo "Invalid second argument: '$mode'. Use 'root' or leave empty." >&2
  exit 1
fi

service="$target"
index="1"

if [[ "$target" =~ ^([a-zA-Z0-9._-]+)-([1-9][0-9]*)$ ]]; then
  service="${BASH_REMATCH[1]}"
  index="${BASH_REMATCH[2]}"
fi

docker compose -f ../compose.yml exec --index "$index" --user "$user" "$service" bash