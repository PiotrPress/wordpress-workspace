{
    "name": "piotrpress/wordpress-workspace",
    "description": "This library is WordPress development environment based on Docker which uses OpenLiteSpeed web server, MariaDB database and Composer dependency manager.",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Piotr Niewiadomski",
            "homepage": "https://github.com/PiotrPress"
        }
    ],
    "homepage": "https://github.com/PiotrPress/wordpress-workspace/",
    "require": {
        "php": "^8.5",
        "piotrpress/wordpress-config": "^3.0.0",
        "piotrpress/wordpress-htaccess": "^2.0.1",
        "piotrpress/wordpress-installer": "^1.0.0",
        "wordpress-core/no-content": "*",
        "wordpress-plugin/hello-dolly": "*",
        "wordpress-theme/twentytwentyfive": "*"
    },
    "config": {
        "allow-plugins": {
            "piotrpress/wordpress-installer": true
        }
    },
    "scripts": {
        "post-update-cmd": [
            "cat vendor/piotrpress/wordpress-htaccess/res/wp-core/.htaccess.cache > wp-core/.htaccess",
            "cat vendor/piotrpress/wordpress-htaccess/res/wp-core/.htaccess.security >> wp-core/.htaccess",
            "cat vendor/piotrpress/wordpress-htaccess/res/wp-core/.htaccess.default >> wp-core/.htaccess",
            "cp vendor/piotrpress/wordpress-config/res/wp-config.php ./wp-config.php",
            "cp -n .config.template .config",
            "ln -nfs ../wp-content wp-core/wp-content",
            "touch wp-content/debug.log",
            "mkdir -p wp-content/uploads",
            "chmod 755 wp-content/uploads",
            "mkdir -p wp-content/languages",
            "chmod 775 wp-content/languages"
        ],
        "format": [
            "@composer install --working-dir=tools/composer-formatter",
            "@composer format ../../composer.json --working-dir=tools/composer-formatter"
        ]
    }
}
